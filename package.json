{
  "name": "kayna-control",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "express": "^4.21.0",
    "nodemailer": "^10.1.1",
    "systeminformation": "^5.27.11"
  },
  "main": "desktop/main.js",
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.kaynadalosse.control",
    "productName": "KAYNÃ CONTROL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "server.js",
      "db.js",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KAYNÃ CONTROL"
    }
  }
}
